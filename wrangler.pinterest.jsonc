{
  "name": "pinterest-poster",
  "main": "pinterest-worker.js",
  "compatibility_date": "2025-09-27",

  // 15:07 UTC ≈ 8am Pacific. Off the hour on purpose — every scheduler in the
  // world fires at :00, and Cloudflare queues cron triggers.
  "triggers": {
    "crons": ["7 15 * * *"]
  },

  // Tracks which pins have already been published, so a regenerated queue
  // doesn't repost anything. One key per pin, written only after Pinterest
  // confirms the pin was created.
  "kv_namespaces": [
    {
      "binding": "PIN_STATE",
      "id": "ba5b155bac0a413a859acac8bfd01bd8"
    }
  ],

  "observability": {
    "enabled": true
  }

  // Secrets (set with `npx wrangler secret put <NAME> --config wrangler.pinterest.jsonc`):
  //   PINTEREST_APP_ID      — from developers.pinterest.com
  //   PINTEREST_APP_SECRET  — same place
  //   ADMIN_KEY             — any long random string; gates every endpoint
  //
  // No access token is stored anywhere: /oauth/start runs the handshake once
  // and the worker keeps a refresh token in KV, minting short-lived access
  // tokens as needed. Pinterest access tokens expire after 30 days, so a
  // pasted one would leave this silently dead a month from now.
}
